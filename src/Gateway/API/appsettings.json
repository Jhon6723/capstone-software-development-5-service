{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "CHANGE_ME_MIN_32_CHARACTERS",
    "Issuer": "https://api.pixpro.com",
    "Audience": "https://api.pixpro.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:4200"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Metadata": {
          "Comment": "Auth endpoints are public - no authentication required"
        }
      },
      "projects-route": {
        "ClusterId": "projects-cluster",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Metadata": {
          "RequestTimeout": "00:05:00"
        }
      },
      "projects-images-route": {
        "ClusterId": "projects-cluster",
        "Match": {
          "Path": "/api/images/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Metadata": {
          "RequestTimeout": "00:10:00"
        }
      },
      "notifications-websocket-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/websocket/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "WebSocketOptions": {
          "Enabled": true
        }
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "AuthorizationPolicy": "default"
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "projects-cluster": {
        "Destinations": {
          "projects-api": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications-api": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
