@Gateway_HostAddress = http://localhost:5000

### Gateway Health Check
GET {{Gateway_HostAddress}}/health
Accept: application/json

###

# ========================================
# US-43: Auth Service Routes via Gateway
# ========================================

### Auth Service Health Check (GET)
GET {{Gateway_HostAddress}}/api/auth/health
Accept: application/json

###

### Register New User (POST)
POST {{Gateway_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Test123!@#",
  "firstName": "Test",
  "lastName": "User"
}

###

### Login User (POST)
POST {{Gateway_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Test123!@#"
}

###

### Get User by Email (GET)
GET {{Gateway_HostAddress}}/api/auth/users/test@example.com
Accept: application/json

###

# ========================================
# US-44: Projects Service Routes via Gateway
# ========================================

### Upload Image (POST with file - Large file upload support)
# Note: Replace with actual file path for testing
POST {{Gateway_HostAddress}}/api/images/upload
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
X-User-Id: 00000000-0000-0000-0000-000000000001

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="test-image.jpg"
Content-Type: image/jpeg

< ./path/to/your/test-image.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

# ========================================
# US-45: Notifications Service Routes via Gateway
# ========================================

### WebSocket Status Check
GET {{Gateway_HostAddress}}/api/websocket/status
Accept: application/json

###

### Create Notification (POST)
POST {{Gateway_HostAddress}}/api/notifications
Content-Type: application/json

{
  "userId": "00000000-0000-0000-0000-000000000001",
  "type": "info",
  "title": "Test Notification",
  "message": "This is a test notification through the gateway"
}

###

### Get Notification by ID (GET)
GET {{Gateway_HostAddress}}/api/notifications/123456
Accept: application/json

###

# WebSocket Connection (Use with WebSocket client or JavaScript)
# Connect to: ws://localhost:5000/api/websocket/connect?access_token=YOUR_JWT_TOKEN
# JavaScript example:
# const ws = new WebSocket('ws://localhost:5000/api/websocket/connect?access_token=' + token);
# ws.onmessage = (event) => console.log('Notification:', event.data);

###
