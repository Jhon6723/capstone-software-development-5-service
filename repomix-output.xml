        var query = new GetUnreadNotificationsQuery(userId);

        // Act
        await _sut.Handle(query, CancellationToken.None);
        await _sut.Handle(query, CancellationToken.None);
        await _sut.Handle(query, CancellationToken.None);

        // Assert
