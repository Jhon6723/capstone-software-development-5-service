export const options = {
  insecureSkipTLSVerify: true,
  scenarios: {
    dos_simulation: {
      executor: "ramping-vus",
      startVUs: 0,
      stages: [
        { duration: "15s", target: 50 },  // ramp up to 50 VUs
        { duration: "30s", target: 50 },  // hold 50 VUs
        { duration: "10s", target: 0 },   // ramp down
      ],
