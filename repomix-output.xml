  cache:
    key: ${CI_COMMIT_REF_SLUG}-pip
    paths:
      - .pip-cache/
  script:
    - cd src/Services/IA
    - pip install --cache-dir $PIP_CACHE_DIR -r requirements.txt
    - pip install --cache-dir $PIP_CACHE_DIR pytest pytest-asyncio
  artifacts:
    paths:
      - src/Services/IA/
    expire_in: 1 hour

test:ia:
  stage: test
  image: python:3.12-slim
  allow_failure: true
  dependencies:
    - build:ia
  variables:
    PIP_CACHE_DIR: "$CI_PROJECT_DIR/.pip-cache"
  cache:
    key: ${CI_COMMIT_REF_SLUG}-pip
    paths:
      - .pip-cache/
  script:
    - cd src/Services/IA
    - pip install --cache-dir $PIP_CACHE_DIR -r requirements.txt
    - pip install --cache-dir $PIP_CACHE_DIR pytest pytest-asyncio
    - pytest tests/ -v --junitxml=test-results.xml || true
  artifacts:
    when: always
    reports:
      junit: src/Services/IA/test-results.xml
    expire_in: 1 week

docker:ia:
  stage: docker
  image: docker:27
  services:
    - docker:27-dind
  variables:
    DOCKER_BUILDKIT: 1
    BUILDKIT_PROGRESS: plain
  rules:
    - if: $CI_COMMIT_BRANCH == "main"
  needs:
    - job: build:ia
      artifacts: false
  before_script:
    - docker login -u $CI_REGISTRY_USER -p $CI_REGISTRY_PASSWORD $CI_REGISTRY
  script:
    - docker pull $REGISTRY_IA:latest || true
    - docker build
      --cache-from $REGISTRY_IA:latest
      --build-arg BUILDKIT_INLINE_CACHE=1
      -t $REGISTRY_IA:$CI_COMMIT_SHA
      -t $REGISTRY_IA:latest
      -f src/Services/IA/Dockerfile
      src/Services/IA
    - docker push $REGISTRY_IA:$CI_COMMIT_SHA
    - docker push $REGISTRY_IA:latest
