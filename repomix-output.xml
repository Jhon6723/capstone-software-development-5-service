<file path="docker-compose.yml">
# service/docker-compose.yml
services:
  frontend:
    image: registry.gitlab.com/jala-university1/cohort-3/es.co.cssd-352.ga.t1.26.m2/sa/syntaxerror2/pix-pro/client/client:latest
    ports:
      - "80:80"
    networks:
      - pixpro_net

  gateway:
    #image: registry.gitlab.com/jala-university1/cohort-3/es.co.cssd-352.ga.t1.26.m2/sa/syntaxerror2/pix-pro/service/service/gateway:latest
    build:
      context: .
      dockerfile: src/Gateway/API/Dockerfile # Uncomment if you want to build locally instead of using the registry image
    ports:
      - "8080:8080"
    networks:
      - pixpro_net
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ASPNETCORE_URLS=http://+:8080
      - Jwt__Secret=${JWT_SECRET}
      - Jwt__Issuer=${JWT_ISSUER}
      - Jwt__Audience=${JWT_AUDIENCE}
      - ReverseProxy__Clusters__auth-cluster__Destinations__auth-api-1__Address=http://auth:8081
      - ReverseProxy__Clusters__projects-cluster__Destinations__projects-api-1__Address=http://projects:8082
      - ReverseProxy__Clusters__notifications-cluster__Destinations__notifications-api-1__Address=http://notifications:8083

  auth:
    #image: registry.gitlab.com/jala-university1/cohort-3/es.co.cssd-352.ga.t1.26.m2/sa/syntaxerror2/pix-pro/service/service/auth:latest
    build:
      context: .
      dockerfile: src/Services/Auth/API/Dockerfile # Uncomment if you want to build locally instead of using the registry image
    expose:
      - "8081"
    networks:
      - pixpro_net
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ASPNETCORE_URLS=http://+:8081
      - AUTH_DB_CONNECTION=Host=db;Port=5432;Database=pixpro_auth;Username=postgres;Password=${DB_PASSWORD}
      - JWT_SECRET=${JWT_SECRET}
      - JWT_ISSUER=${JWT_ISSUER}
      - JWT_AUDIENCE=${JWT_AUDIENCE}


  projects:
    #image: registry.gitlab.com/jala-university1/cohort-3/es.co.cssd-352.ga.t1.26.m2/sa/syntaxerror2/pix-pro/service/service/projects:latest
    build:
      context: .
      dockerfile: src/Services/Projects/API/Dockerfile # Uncomment if you want to build locally instead of using the registry image
    expose:
      - "8082"
    networks:
      - pixpro_net
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ASPNETCORE_URLS=http://+:8082
      - ConnectionStrings__ProjectsDb=Host=projects-db;Port=5432;Database=pixpro_projects;Username=postgres;Password=${PROJECTS_DB_PASSWORD}
      - Jwt__Secret=${JWT_SECRET}
      - Jwt__Issuer=${JWT_ISSUER}
      - Jwt__Audience=${JWT_AUDIENCE}
      - Cloudinary__CloudName=${CLOUDINARY_CLOUD_NAME}
      - Cloudinary__ApiKey=${CLOUDINARY_API_KEY}
      - Cloudinary__ApiSecret=${CLOUDINARY_API_SECRET}
      - RabbitMQ__Host=rabbitmq
      - RabbitMQ__Username=${RABBITMQ_USER}
      - RabbitMQ__Password=${RABBITMQ_PASSWORD}
    depends_on:
      - rabbitmq
      - projects-db

  ia:
    build:
      context: .
      dockerfile: src/Services/IA/Dockerfile
    expose:
      - "8084"
    networks:
      - pixpro_net
    environment:
      - DATABASE_URL=postgresql://postgres:${IA_DB_PASSWORD}@ia-db:5432/pixpro_ia
      - RabbitMQ__Host=rabbitmq
      - RabbitMQ__Username=${RABBITMQ_USER}
      - RabbitMQ__Password=${RABBITMQ_PASSWORD}
      - CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}
      - CLOUDINARY_API_KEY=${CLOUDINARY_API_KEY}
      - CLOUDINARY_API_SECRET=${CLOUDINARY_API_SECRET}
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - POLLINATIONS_API_KEY=${POLLINATIONS_API_KEY}
      - POLLINATIONS_ENDPOINT=${POLLINATIONS_ENDPOINT}
      - PIXAZO_API_KEY=${PIXAZO_API_KEY}
    depends_on:
      rabbitmq:
        condition: service_healthy
      ia-db:
        condition: service_started

  ia-db:
    image: postgres:16-alpine
    ports:
      - "5434:5432"
    environment:
      - POSTGRES_DB=pixpro_ia
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=${IA_DB_PASSWORD}
    volumes:
      - ia_db_data:/var/lib/postgresql/data
    networks:
      - pixpro_net

  notifications:
    # image: registry.gitlab.com/jala-university1/cohort-3/es.co.cssd-352.ga.t1.26.m2/sa/syntaxerror2/pix-pro/service/service/notifications:latest
    build:
      context: .
      dockerfile: src/Services/Notifications/API/Dockerfile # Uncomment if you want to build locally instead of using the registry image
    expose:
      - "8083"
      - "8443"
    ports:
      - "8443:8443"
    networks:
      - pixpro_net
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ASPNETCORE_URLS=http://+:8083;https://+:8443
      - ConnectionStrings__NotificationsDb=mongodb://${NOTIFICATIONS_DB_USER}:${NOTIFICATIONS_DB_PASSWORD}@notifications-db:27017/pixpro_notifications?authSource=admin
      - ConnectionStrings__Redis=redis:6379
      - Redis__Password=${REDIS_PASSWORD}
      - RabbitMQ__Host=rabbitmq
      - RabbitMQ__Username=${RABBITMQ_USER}
      - RabbitMQ__Password=${RABBITMQ_PASSWORD}
      - Jwt__Secret=${JWT_SECRET}
      - Jwt__Issuer=${JWT_ISSUER}
      - Jwt__Audience=${JWT_AUDIENCE}
      - Kestrel__Endpoints__Https__Certificate__Password=${KESTREL_CERT_PASSWORD}
    depends_on:
      - rabbitmq
      - notifications-db
      - redis

  rabbitmq:
    image: rabbitmq:3-management-alpine
    ports:
      - "5672:5672" # AMQP port
      - "15672:15672" # Management UI

    environment:
      - RABBITMQ_DEFAULT_USER=${RABBITMQ_USER}
      - RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD}
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
    networks:
      - pixpro_net
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  db:
    image: postgres:16-alpine
    ports:
      - "5432:5432"
    environment:
      - POSTGRES_PASSWORD=${DB_PASSWORD}
      - POSTGRES_DB=pixpro_auth
      - POSTGRES_USER=postgres
    volumes:
      - db_data:/var/lib/postgresql/data
    networks:
      - pixpro_net

  projects-db:
    image: postgres:16-alpine
    ports:
      - "5433:5432"
    environment:
      - POSTGRES_DB=pixpro_projects
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=${PROJECTS_DB_PASSWORD}
    volumes:
      - projects_db_data:/var/lib/postgresql/data
    networks:
      - pixpro_net

  notifications-db:
    image: mongo:7.0
    ports:
      - "27017:27017"
    environment:
      - MONGO_INITDB_ROOT_USERNAME=${NOTIFICATIONS_DB_USER}
      - MONGO_INITDB_ROOT_PASSWORD=${NOTIFICATIONS_DB_PASSWORD}
      - MONGO_INITDB_DATABASE=pixpro_notifications
    volumes:
      - notifications_db_data:/data/db
    networks:
      - pixpro_net

  redis:
    image: redis:7.2-alpine
    ports:
      - "6379:6379"
    command: redis-server --requirepass ${REDIS_PASSWORD}
    volumes:
      - redis_data:/data
    networks:
      - pixpro_net
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

networks:
  pixpro_net:
    driver: bridge

volumes:
  ia_db_data:
  db_data:
  projects_db_data:
  notifications_db_data:
  rabbitmq_data:
  redis_data:
</file>

