# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Auth Service - PostgreSQL
DB_PASSWORD=pix-pro-auth-secure-password

# Projects Service - PostgreSQL
PROJECTS_DB_PASSWORD=projects-secure-password

# Notifications Service - MongoDB
NOTIFICATIONS_DB_USER=pixpro_notifications
NOTIFICATIONS_DB_PASSWORD=notifications-secure-password
ConnectionStrings__NotificationsDb=mongodb://localhost:27017/pixpro_notifications

# ===========================================
# MESSAGE BROKER - RABBITMQ
# ===========================================
RABBITMQ_USER=pixpro
RABBITMQ_PASSWORD=rabbitmq-secure-password
RabbitMQ__Host=localhost
RabbitMQ__Username=guest
RabbitMQ__Password=guest
RabbitMQ__Queues__UserEvents=user-events
RabbitMQ__Queues__ProjectEvents=project-events
RabbitMQ__Queues__Notifications=notifications
RabbitMQ__Queues__ImageProcessingEvents=image-processing-events

# ===========================================
# JWT CONFIGURATION (CRITICAL: MUST BE SAME IN ALL SERVICES)
# ===========================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_ISSUER=https://api.pixpro.com
JWT_AUDIENCE=https://api.pixpro.com
JWT_EXPIRATION_MINUTES=60
Jwt__Secret=your_super_secret_jwt_key_min_32_characters_long
Jwt__Issuer=https://api.pixpro.com
Jwt__Audience=https://api.pixpro.com
Jwt__ExpirationMinutes=60

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Auth0
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_AUDIENCE=https://api.pixpro.com