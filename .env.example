# Database Configuration
DB_PASSWORD=pix-pro-auth
ConnectionStrings__AuthDb=Host=localhost;Port=5432;Database=pixpro_auth;Username=postgres;Password=CHANGE_ME

# Auth0 Configuration (if using Auth0)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.pixpro.com
AUTH0_CLIENT_ID=your_client_id_here
AUTH0_CLIENT_SECRET=your_client_secret_here
Auth0__Domain=your-tenant.auth0.com
Auth0__Audience=https://api.pixpro.com
Auth0__ClientId=your_client_id_here
Auth0__ClientSecret=your_client_secret_here

# JWT Configuration (if using custom JWT instead of Auth0)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_ISSUER=https://api.pixpro.com
JWT_AUDIENCE=https://api.pixpro.com
JWT_EXPIRATION_MINUTES=60
Jwt__Secret=your_super_secret_jwt_key_min_32_characters_long
Jwt__Issuer=https://api.pixpro.com
Jwt__Audience=https://api.pixpro.com
Jwt__ExpirationMinutes=60

# Environment
ASPNETCORE_ENVIRONMENT=Development
