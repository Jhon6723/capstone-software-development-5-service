# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Auth Service - PostgreSQL
DB_PASSWORD=pix-pro-auth-secure-password
AUTH_DB_CONNECTION=your_auth_db_connection_string_here
AuthDb__Connection=your_auth_db_connection_string_here

# Projects Service - PostgreSQL
PROJECTS_DB_PASSWORD=projects-secure-password
CONNECTIONSTRINGS_PROJECTSDB=your_projects_db_connection_string_here
ConnectionStrings__ProjectsDb=your_projects_db_connection_string_here

# Notifications Service - MongoDB
NOTIFICATIONS_DB_USER=pixpro_notifications
NOTIFICATIONS_DB_PASSWORD=notifications-secure-password
CONNECTIONSTRINGS_NOTIFICATIONSDB=your_notifications_db_connection_string_here
ConnectionStrings__NotificationsDb=mongodb://localhost:27017/pixpro_notifications

# ===========================================
# MESSAGE BROKER - RABBITMQ
# ===========================================
RABBITMQ_USER=pixpro
RABBITMQ_PASSWORD=rabbitmq-secure-password
RabbitMQ__Host=localhost
RabbitMQ__Username=guest
RabbitMQ__Password=guest
RabbitMQ__Queues__UserEvents=user-events
RabbitMQ__Queues__ProjectEvents=project-events
RabbitMQ__Queues__Notifications=notifications
RabbitMQ__Queues__ImageProcessingEvents=image-processing-events

# ===========================================
# JWT CONFIGURATION (CRITICAL: MUST BE SAME IN ALL SERVICES)
# ===========================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_ISSUER=https://api.pixpro.com
JWT_AUDIENCE=https://api.pixpro.com
JWT_EXPIRATION_MINUTES=60
Jwt__Secret=your_super_secret_jwt_key_min_32_characters_long
Jwt__Issuer=https://api.pixpro.com
Jwt__Audience=https://api.pixpro.com
Jwt__ExpirationMinutes=60

# TLS Certificate (Notifications WSS)
Kestrel__Endpoints__Https__Certificate__Password=your_cert_password_here
KESTREL_CERT_PASSWORD=your_cert_password_here

# Environment
ASPNETCORE_ENVIRONMENT=environment_type_here

# Auth0
AUTH0_DOMAIN=your_auth0_domain
AUTH0_AUDIENCE=https://api.pixpro.com
Auth0__Domain=your_auth0_domain
Auth0__Audience=https://api.pixpro.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
Cloudinary__CloudName=your_cloudinary_cloud_name
Cloudinary__ApiKey=your_cloudinary_api_key
Cloudinary__ApiSecret=your_cloudinary_api_secret

# AI Models (optional - falls back to mock if not set)
HF_TOKEN=
OPENAI_API_KEY=sk-proj
IA_DB_PASSWORD=
POLLINATIONS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
POLLINATIONS_ENDPOINT=https://gen.pollinations.ai
PIXAZO_API_KEY=